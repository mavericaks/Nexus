{
  "title": "Nexus AI Triage",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Triage Volume by Category",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (category) (rate(ticket_triage_count_total[1m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Auto-Resolve Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ticket_triage_count_total{autoResolved=\"true\"}[5m])) / sum(rate(ticket_triage_count_total[5m])) * 100",
          "legendFormat": "Auto-resolved %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Triage Duration (Percentiles)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ticket_triage_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ticket_triage_duration_milliseconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Rate Limit Denials by Tenant",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (tenantId) (rate(rate_limit_denied_count_total[1m]))",
          "legendFormat": "{{tenantId}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Confidence Score Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "avg by (category) (ticket_triage_confidence_sum / ticket_triage_confidence_count)",
          "legendFormat": "Avg Confidence - {{category}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "LLM Circuit Breaker State",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"groq-llm\", state=\"open\"}",
          "legendFormat": "Open Circuit"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
